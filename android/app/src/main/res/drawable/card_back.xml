<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#17102F" />
            <stroke android:width="3dp" android:color="#F6C453" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#24164B" />
            <stroke android:width="1dp" android:color="#B69AF8" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#7C4DFF" />
            <stroke android:width="3dp" android:color="#F6C453" />
        </shape>
    </item>
    <item android:width="24dp" android:height="24dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#F6C453" />
        </shape>
    </item>
</layer-list>
